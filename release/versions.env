# LumenRL release pin — the exact four-repo state validated on MI355X (gfx950).
#
# Sourced by release/build_image.sh and release/fetch_sources.sh so the image and
# a fresh checkout always agree. Every SHA here was exercised end-to-end; see
# release/README.md for the validation matrix.
#
# Validated: 2026-09-10 on 8x MI355X (gfx950), ROCm 7.2, vLLM 0.23.0

# --- Lumen-RL: RL framework (this repo) ---
# Not pinned, and not what runs: release/run_example.sh bind-mounts the checkout
# it lives in over /opt/lumenrl/Lumen-RL, so the code comes from your working
# tree and the image never has to be rebuilt for a Lumen-RL change. The build
# still clones the branch below, because the editable install needs a path to
# point at and a bare `docker run` should land on something that works.
#
# Only the three upstream repositories below carry a SHA, because those are what
# a result depends on and what a rebuild is actually for.
LUMENRL_REPO=https://github.com/ZhangDanyang-AMD/Lumen-RL.git
LUMENRL_BRANCH=dev/dapo_release

# --- Lumen: FSDP2 / Megatron training backend (FP8) ---
LUMEN_REPO=https://github.com/ZhangDanyang-AMD/Lumen.git
LUMEN_BRANCH=amd-atom-rollout
LUMEN_SHA=e6379cbd9057b03c18213fbf65a4d891160545ca

# --- aiter: AMD kernels ---
# lumen/moe forks ROCm/aiter main at f2f8ed9b2, which is the last commit before
# PR #5149 reverted the Triton kernels Lumen needs. It also carries the newer
# aiter.ops.shuffle API that ATOM >= 2026-07-11 imports at module scope, so this
# is the one branch that satisfies both sides.
AITER_REPO=https://github.com/ZhangDanyang-AMD/aiter.git
AITER_BRANCH=lumen/moe
AITER_SHA=4ebe6d69c7f4aa8f3af318928dea8c44393d9ee6
# 3rdparty/composable_kernel submodule, required by the aiter JIT
AITER_CK_SHA=af9e1d1f1ae347c22feeb08fd2d42645075e0c5d

# --- ATOM: alternative rollout engine (examples 4, 5, 9) ---
# Upstream ROCm/ATOM. PR #2028 ("[Lumen-RL] Improve FP8 rollout weight
# synchronization and CUDA Graph stability") was squash-merged on 2026-09-16, so
# this is now a commit on main rather than a PR head.
#
# This pin REQUIRES one setting in lumenrl/engine/inference/atom_ray_server.py,
# supplied by _pin_cudagraph_mode and applying only to a no-eager rollout:
#
#   compilation_config.cudagraph_mode=FULL
#     ATOM enables a per-piece cudagraph wrapper, so a level-3 rollout defaults to
#     per-piece capture, which the eager attention boundary between two pieces
#     invalidates on the first replay. Without it all rollout workers abort with
#     "Input addresses for cudagraphs are different during replay". Reproduced on
#     this pin's branch on 2026-09-16: 8/8 replicas, before any sleep.
#
# It is a no-op on older ATOM builds: ATOM filters engine kwargs against its
# Config dataclass fields and drops the ones a given build does not declare.
#
# There used to be a second pin here, sleep_keeps_memory_resident=true, justified
# by "example 9 aborts all eight replicas in resume_memory with a negative KV
# pool". That did not reproduce -- not on this pin, and not on the image's older
# d6b9e147 either. Both ran example 9 to a clean --check PASS with 24/24 sleeps
# releasing and recapturing and zero negative pools. The pin was removed on
# 2026-09-16 and sleep now follows ATOM's own default, which is to release.
# The cost is one graph recapture per step -- measured at about 1 s/step, 2-3%,
# on examples 4 and 9 -- and a k3_kl that sits 11-43% higher than resident
# sleep's, which is why example 5's reference value was re-measured. Both
# numbers are in release/VALIDATION.md.
ATOM_REPO=https://github.com/ROCm/ATOM.git
ATOM_BRANCH=main
ATOM_SHA=8b6d61392b0690ff338b6ccd6b864a63ecaf45c3

# --- Base image and the pinned python deps that differ from it ---
BASE_IMAGE=vllm/vllm-openai-rocm:v0.23.0
# The base image ships flydsl 0.1.4.2; aiter lumen/moe requires >= 0.2.4 and
# pins 0.3.2. This is the single most common upgrade failure.
FLYDSL_VERSION=0.3.2
MEGATRON_CORE_VERSION=0.18.2
APEX_SHA=daed85255d51476425080e7e6203f0bee6d7e4cc
TE_SHA=6e541a10419a6e31bdc98b1516db04eb81a463b6
