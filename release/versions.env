# LumenRL release pin — the exact four-repo state validated on MI355X (gfx950).
#
# Sourced by release/build_image.sh and release/fetch_sources.sh so the image and
# a fresh checkout always agree. Every SHA here was exercised end-to-end; see
# release/README.md for the validation matrix.
#
# Validated: 2026-09-02 on 8x MI355X (gfx950), ROCm 7.2, vLLM 0.23.0

# --- Lumen-RL: RL framework (this repo) ---
LUMENRL_REPO=https://github.com/ZhangDanyang-AMD/Lumen-RL.git
LUMENRL_BRANCH=dev/dsv4-dapo
LUMENRL_SHA=6957ee9c1c79d1abae79a69f91ac362f0b3e6d1b

# --- Lumen: FSDP2 / Megatron training backend (FP8) ---
LUMEN_REPO=https://github.com/ZhangDanyang-AMD/Lumen.git
LUMEN_BRANCH=amd-atom-rollout
LUMEN_SHA=e6379cbd9057b03c18213fbf65a4d891160545ca

# --- aiter: AMD kernels ---
# lumen/moe forks ROCm/aiter main at f2f8ed9b2, which is the last commit before
# PR #5149 reverted the Triton kernels Lumen needs. It also carries the newer
# aiter.ops.shuffle API that ATOM >= 2026-07-11 imports at module scope, so this
# is the one branch that satisfies both sides.
AITER_REPO=https://github.com/ZhangDanyang-AMD/aiter.git
AITER_BRANCH=lumen/moe
AITER_SHA=4ebe6d69c7f4aa8f3af318928dea8c44393d9ee6
# 3rdparty/composable_kernel submodule, required by the aiter JIT
AITER_CK_SHA=af9e1d1f1ae347c22feeb08fd2d42645075e0c5d

# --- ATOM: alternative rollout engine (examples 4, 5) ---
ATOM_REPO=https://github.com/xysheng-AMD/ATOM.git
ATOM_BRANCH=lumen-rl
ATOM_SHA=7173f5b8f75849fec98f3943077deb44c00925d2

# --- Base image and the pinned python deps that differ from it ---
BASE_IMAGE=vllm/vllm-openai-rocm:v0.23.0
# The base image ships flydsl 0.1.4.2; aiter lumen/moe requires >= 0.2.4 and
# pins 0.3.2. This is the single most common upgrade failure.
FLYDSL_VERSION=0.3.2
MEGATRON_CORE_VERSION=0.18.2
APEX_SHA=daed85255d51476425080e7e6203f0bee6d7e4cc
TE_SHA=6e541a10419a6e31bdc98b1516db04eb81a463b6
